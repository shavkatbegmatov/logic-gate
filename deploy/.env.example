# Logic Gate serveri sozlamalari. setup.sh bu faylni /etc/logicgate.env ga nusxalaydi
# (agar u yerda fayl hali bo'lmasa). O'zgartirgandan keyin: sudo systemctl restart logicgate

# Server faqat lokal manzilda tinglaydi — tashqaridan Nginx orqali kiriladi.
LG_ADDR=127.0.0.1:8080

# SQLite bazasi.
LG_DB=/var/lib/logicgate/logicgate.db

# Go uchun yumshoq xotira chegarasi: GC uyumni shu hajmdan oshirmaslikka harakat qiladi.
GOMEMLIMIT=40MiB
